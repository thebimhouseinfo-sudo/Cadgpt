# CadGPT slim loopback MCP control plane.
HOST=127.0.0.1
PORT=3100

# Source/dev builds expose development-only capabilities such as cad-mcp-dev.
# Production packaging MUST set this to production and strip those capabilities.
CADGPT_BUILD_PROFILE=development

# Admission/work authority lifetimes.
CADGPT_ADMISSION_TTL_MS=1800000
CADGPT_WORK_IDLE_MS=600000
CADGPT_WORK_SWEEP_MS=30000

# CadGPT user/runtime data root.
# Beta keeps this inside the repository. Packaged builds can point it to an
# absolute per-user path such as %LOCALAPPDATA%\CadGPT.
CADGPT_APPDATA_ROOT=appdata

# MCP session recovery/transport state.
MCP_SESSION_RECOVERY=true
MCP_SESSION_TTL_MS=86400000
MCP_SESSION_CLEANUP_MS=300000
MCP_SESSION_DELETE_GRACE_MS=45000

# Required opaque local MCP path token. setup/openai-tunnel -Init generates it.
# CadGPT refuses to start an unprotected /mcp endpoint when this is empty.
MCP_TOKEN=

# OpenAI Secure MCP Tunnel. Filled during setup.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=
OPENAI_TUNNEL_HEALTH_PORT=8180

# CAD MCP upstream process. It remains off until an admitted CAD work execution
# actually calls a CAD capability. CadGPT never launches AutoCAD itself.
CAD_MCP_PYTHON=.venv-cad\Scripts\python.exe
CAD_MCP_ENTRY=runtimes\cad-mcp\main.py
CAD_MCP_CONNECT_TIMEOUT_MS=15000

# User Lisp/Job source folders are import sources only. All source mutations
# inside CadGPT authoring workflows require explicit absolute canonical paths
# inside the workflow-owned allowed root.
