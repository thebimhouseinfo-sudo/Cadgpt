# CadGPT public loopback endpoint owned by the tiny wake-agent.
HOST=127.0.0.1
PORT=3000

# Full CadGPT MCP wakes on demand behind the public wake-agent.
CADGPT_INTERNAL_PORT=3001
CADGPT_WAKE_POLL_MS=2500

# Optional opaque local MCP path token. When set, ChatGPT tunnel targets /mcp/<token>.
MCP_TOKEN=

# OpenAI Secure MCP Tunnel. Filled during setup.
OPENAI_TUNNEL_ID=
OPENAI_TUNNEL_API_KEY=
OPENAI_TUNNEL_HEALTH_PORT=8080

# CAD MCP upstream process. It is activated while acad.exe is detected and shut down when AutoCAD closes.
CAD_MCP_PYTHON=.venv-cad\Scripts\python.exe
CAD_MCP_ENTRY=runtimes\cad-mcp\main.py
CAD_MCP_CONNECT_TIMEOUT_MS=15000

# Explicit editable roots. Keep narrow by default.
CADGPT_FILE_ROOTS=lisp;jobs
