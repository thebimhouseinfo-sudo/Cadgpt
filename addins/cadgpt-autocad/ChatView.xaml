<UserControl x:Class="CadGpt.AutoCad.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             MinWidth="320"
             MinHeight="420">
    <Grid x:Name="RootGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="ToolbarBorder"
                Grid.Row="0"
                Padding="8,6"
                Background="White"
                BorderThickness="0,0,0,1"
                BorderBrush="#22000000">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="BoundDrawingText"
                           Grid.Column="0"
                           Margin="2,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Text="Not bound" />

                <Button x:Name="ThemeButton"
                        Grid.Column="1"
                        Padding="8,4"
                        Click="ThemeButton_Click"
                        ToolTip="Toggle add-in chrome between light and dark.">
                    Dark
                </Button>
            </Grid>
        </Border>

        <Border x:Name="JobTickerBorder"
                Grid.Row="1"
                Padding="8,3"
                Visibility="Collapsed"
                ClipToBounds="True"
                BorderThickness="0,0,0,1"
                BorderBrush="#22000000">
            <Grid x:Name="JobTickerViewport"
                  ClipToBounds="True">
                <TextBlock x:Name="JobTickerText"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="JobTickerTransform" />
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Border>

        <wv2:WebView2 x:Name="Browser"
                      Grid.Row="2" />
    </Grid>
</UserControl>
